function f_grebase() {
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "❌ Error: Not inside a Git repository."
    return 1
  fi

  if ! git remote get-url origin >/dev/null 2>&1; then
    echo "❌ Error: Remote 'origin' is not configured."
    return 1
  fi

  # Get the remote default branch name (for example: main/master).
  local default_branch
  default_branch=$(git remote show origin 2>/dev/null | sed -n '/HEAD branch/s/.*: //p')

  if [[ -z "$default_branch" ]]; then
    echo "❌ Error: Could not detect default branch from 'origin'."
    return 1
  fi

  echo "🔄 Detected default branch: $default_branch"
  echo "📥 Fetching latest changes..."
  if ! git fetch origin; then
    echo "❌ Error: Failed to fetch from 'origin'."
    return 1
  fi

  echo "🚀 Rebasing current branch onto origin/$default_branch..."
  if git rebase "origin/$default_branch"; then
    echo "✅ Successfully rebased!"
    return 0
  fi

  echo "⚠️  Rebase paused due to conflicts. Resolve them and run 'git rebase --continue'."
  return 1
}
